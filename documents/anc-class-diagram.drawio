        <mxCell id="TnW4fBOS_iKetNsBtfqp-9" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="Originally wanted to use EnvLogger, but it isn&#39;t meant for conditional writing.&amp;nbsp;&lt;div&gt;It &quot;fires and forgets&quot;, while our requirement is something that prompts before writing.&amp;nbsp;&lt;div&gt;(extending envlogger makes little sense since its responsibility is just dumping everything).&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;Hence we will write it ourselves =)!&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Update: apparently cntinous dumping is kind of the way to go since&lt;/div&gt;&lt;div&gt;&amp;nbsp;recording data uncompressed is actually too much for the 2GB RAM .&lt;br&gt;&lt;br&gt;Update: &lt;i&gt;apparently&lt;/i&gt;&amp;nbsp;when &lt;i&gt;Google Deepmind&lt;/i&gt;&amp;nbsp;said it works&lt;/div&gt;&lt;div&gt;&amp;nbsp;for &lt;i&gt;Linux OS&#39;s with python 3&lt;/i&gt;&amp;nbsp;they forgot to mention &lt;i&gt;aarch64 doesn&#39;t work. &lt;/i&gt;Hence we go back&lt;/div&gt;&lt;div&gt;&amp;nbsp;to writing something else, probably HDF5?&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="520" x="1490" y="220" as="geometry" />
        </mxCell>
        <mxCell id="TnW4fBOS_iKetNsBtfqp-11" edge="1" parent="1" source="TnW4fBOS_iKetNsBtfqp-10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;dashPattern=1 4;" target="c-tI-Pw4X1QRDRTb0sTA-8">
