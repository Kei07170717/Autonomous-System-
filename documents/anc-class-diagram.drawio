        <mxCell id="l2g027vyWRO9pB_clHzg-22" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;gradientColor=none;shadow=0;rounded=0;glass=0;opacity=20;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Cobot...&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="40" width="160" x="380" y="970" as="geometry" />
        </mxCell>
        <mxCell id="l2g027vyWRO9pB_clHzg-29" edge="1" parent="1" source="l2g027vyWRO9pB_clHzg-23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=0;" target="XMMmHGujoTGXHxvXuvVy-3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="700" />
              <mxPoint x="730" y="700" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="l2g027vyWRO9pB_clHzg-23" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;GripperSensorModule&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="50" width="160" x="380" y="740" as="geometry" />
        </mxCell>
        <mxCell id="l2g027vyWRO9pB_clHzg-25" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;gradientColor=none;shadow=0;rounded=0;glass=0;opacity=20;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Cobot...&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="40" width="160" x="740" y="970" as="geometry" />
        </mxCell>
        <mxCell id="CWc_muIFBfJnSlnraKPb-1" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="The ANCController is the biggest component of the project.&amp;nbsp;&amp;nbsp;&lt;div&gt;Its responsibility is managing the states and hence the interaction between&lt;/div&gt;&lt;div&gt;agent and environment. The controller applies the state pattern, meaning that it&#39;s&lt;/div&gt;&lt;div&gt;&#39;chopped&#39; into multiple state objects. Each state object overrides the behavior of&amp;nbsp;&lt;/div&gt;&lt;div&gt;the controller and can also decide its transitions to other states.&lt;/div&gt;&lt;div&gt;For example, RecordingState creates an Environment and KinestheticAgent&lt;/div&gt;&lt;div&gt;to record actions which later can be replayed by the ReplayRecordState.&amp;nbsp;&lt;/div&gt;&lt;div&gt;This approach encapsulates logic for each state. A drawback is that the state pattern&lt;/div&gt;&lt;div&gt;is quite tightly coupled to the original object (anccontroller) and hence accessing variables&lt;/div&gt;&lt;div&gt;can feel a bit messy since Python doesn&#39;t care about access encapsulation.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;States can &#39;share&#39; variables by making sure the self.context (controller) have them defined.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Therefor don&#39;t have any constructor(init) parameters. This feels ugly, but I have yet to figure&lt;/div&gt;&lt;div&gt;&amp;nbsp;out if that&#39;s expected for the state pattern (feedback is welcome).&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="210" width="510" x="-255" y="-720" as="geometry" />
        </mxCell>
        <mxCell id="7rCRljNplWGLdsxQep_x-2" edge="1" parent="1" source="aS8GcyPMerlu9VfCXUhh-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="6IN2ToZFyXFvdCxiWt0Y-20">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="aS8GcyPMerlu9VfCXUhh-1" parent="1" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;HDF5Writer&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;-&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;init(path, features_dict)&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ write_step()&lt;br&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ new_episode()&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+ write_episode_metadata()&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+&amp;nbsp;&lt;/p&gt;" vertex="1">
