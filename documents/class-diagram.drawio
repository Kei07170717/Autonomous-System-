        </mxCell>
        <mxCell id="TnW4fBOS_iKetNsBtfqp-10" value="&lt;font style=&quot;font-size: 9px;&quot;&gt;Controversial, just mirrors&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;the observed joint angles&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
