        <mxCell id="TnW4fBOS_iKetNsBtfqp-1" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Dummy&lt;/b&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;RecordedEnvironment&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;+&amp;nbsp;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+&lt;/span&gt;&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:4px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;+&lt;/span&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1120" y="450" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="TnW4fBOS_iKetNsBtfqp-9" value="Originally wanted to use EnvLogger, but it isn&#39;t meant for conditional writing.&amp;nbsp;&lt;div&gt;It &quot;fires and forgets&quot;, while our requirement is something that prompts before writing.&amp;nbsp;&lt;div&gt;(extending envlogger makes little sense since its responsibility is just dumping everything).&amp;nbsp;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;Hence we will write it ourselves =)!&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Update: apparently cntinous dumping is kind of the way to go since&lt;/div&gt;&lt;div&gt;&amp;nbsp;recording data uncompressed is actually.&lt;br&gt;&lt;br&gt;Update: &lt;i&gt;apparently&lt;/i&gt;&amp;nbsp;when &lt;i&gt;Google Deepmind&lt;/i&gt;&amp;nbsp;said it works&lt;/div&gt;&lt;div&gt;&amp;nbsp;for &lt;i&gt;Linux OS&#39;s with python 3&lt;/i&gt;&amp;nbsp;they forgot to mention &lt;i&gt;aarch64 doesn&#39;t work. &lt;/i&gt;Hence we go back&lt;/div&gt;&lt;div&gt;&amp;nbsp;to writing something else, probably HDF5?&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="1490" y="220" width="520" height="170" as="geometry" />
        </mxCell>
